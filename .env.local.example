# Database (Neon pooled connection string)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Meilisearch (optional — search falls back to Prisma when unavailable)
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin notification webhook (optional — new inquiries are always stored in the DB)
# provider: wecom (default) | dingtalk | telegram
NOTIFY_PROVIDER="wecom"
NOTIFY_WEBHOOK_URL=""
# telegram only:
NOTIFY_CHAT_ID=""